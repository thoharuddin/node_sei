{
  "name": "stock-opname-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Stock Opname (physical inventory audit) system — Node.js/Express/PostgreSQL backend",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "prisma:generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "migrate:reset": "prisma migrate reset --force",
    "seed": "node prisma/seed.js",
    "db:setup": "npm run migrate && npm run seed",
    "test": "jest --runInBand",
    "test:watch": "jest --runInBand --watch"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "jest": "^30.5.1",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2"
  }
}
